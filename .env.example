# Copy to .env and fill in. .env is git-ignored.

# Twitch app (dev.twitch.tv/console → Register Your Application, Client Type "Confidential")
NITCH_TWITCH_CLIENT_ID=
NITCH_TWITCH_CLIENT_SECRET=

# Only for deploy/stack.yaml (home server with an NFS share and VA-API, docs/INSTALL.md)
# NITCH_NFS_ADDR=192.168.1.2
# NITCH_NFS_PATH=/export/nitch
# NITCH_RENDER_GID=104
# NITCH_VIDEO_GID=44
